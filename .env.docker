# Application Settings
APP_NAME="VIMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# URLs
APP_URL=https://veruliya.com
ASSET_URL=https://veruliya.com
VITE_APP_URL=https://veruliya.com

# Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Session
SESSION_DOMAIN=veruliya.com
SESSION_SECURE_COOKIE=true

# Docker
COMPOSE_PROJECT_NAME=veruvel